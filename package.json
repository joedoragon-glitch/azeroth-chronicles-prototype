{
  "name": "azeroth-chronicles-prototype",
  "version": "0.8.83",
  "private": true,
  "description": "Offline installable RPG prototype for Chromebook and mobile.",
  "scripts": {
    "test": "node tests/run.cjs",
    "test:browser": "node tests/prototype-browser.test.cjs",
    "test:quick": "node tests/run.cjs --quick",
    "build": "node scripts/build.cjs",
    "check": "node scripts/build.cjs --check",
    "dev": "node scripts/dev.cjs",
    "format": "prettier --write \"src/prototype/*.js\" \"styles/prototype.css\" \"styles/desktop.css\" \"styles/phone.css\" \"scripts/*.cjs\" tests/platform-runtime.test.cjs tests/run.cjs",
    "format:check": "prettier --check \"src/prototype/*.js\" \"styles/prototype.css\" \"styles/desktop.css\" \"styles/phone.css\" \"scripts/*.cjs\" tests/platform-runtime.test.cjs tests/run.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "3.5.3"
  }
}
